# Copy this file to .env and fill in the values from your Shopify Partner
# Dashboard app (Apps > cod-profit-app > Client credentials) after running
# `shopify app config link`.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,write_orders,read_products,read_fulfillments
SHOPIFY_APP_URL=https://your-app-url.example.com

# Postgres connection string. Get this from your Postgres provider (e.g.
# Railway's Postgres plugin gives you one directly; a free Neon.tech
# project works too). Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional: only needed once you connect the Meta ad spend integration.
# Merchants enter their own token/account id in-app; these are just
# fallback/dev values if you want to test without the UI.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Billing (see app/services/billing.server.ts). Charges against a
# development store are always test charges regardless of this flag.
# Leave unset (defaults to true = no real money) until you're ready to
# charge real, live merchants — then set this to "false" in production.
SHOPIFY_BILLING_TEST=true

# REQUIRED once you connect any ad platform (see app/services/crypto.server.ts
# and app/routes/app.ad-spend.tsx). Encrypts merchants' Meta/Google/TikTok/
# Snapchat ad account tokens before they're stored in the database. Must be
# a 64-character hex string (32 random bytes) — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in every environment that reads this database (local
# .env and your production host's variables) — if it ever changes, existing
# connections can no longer be decrypted and merchants will need to
# reconnect their ad accounts. Keep this secret; anyone with it can decrypt
# stored tokens.
TOKEN_ENCRYPTION_KEY=
